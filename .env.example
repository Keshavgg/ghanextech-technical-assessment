# Environment Variables Configuration
# Copy this file to .env and insert your optional credentials.

# Google Gemini API Key (Optional - for advanced generative synthesis & native function calling)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# GitHub Personal Access Token (Optional - increases GitHub REST API rate limits from 60/hr to 5,000/hr)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=
